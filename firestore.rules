rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Admin = SOLO estas cuentas (UID de Firebase Auth): Leonardo y La Hornilla.
       Para agregar a alguien: Authentication → Usuarios → copia su UID y ponlo en la lista. */
    function esAdmin() {
      return request.auth != null
        && request.auth.uid in ['P548YHTdNVV1tQrZQUlzhkeZ0Uw2', 'V1iwBc8viwVXkGPZPAjeGVDh7wn1'];
    }

    /* Menú y promociones: lectura pública, escritura solo admin */
    match /promociones/{doc}     { allow read: if true; allow write: if esAdmin(); }
    match /menuPrincipal/{doc}   { allow read: if true; allow write: if esAdmin(); }
    match /menuPupusas/{doc}     { allow read: if true; allow write: if esAdmin(); }
    match /menuCategorias/{doc}  { allow read: if true; allow write: if esAdmin(); }
    match /menuBebidas/{doc}     { allow read: if true; allow write: if esAdmin(); }
    match /menuExtras/{doc}      { allow read: if true; allow write: if esAdmin(); }

    /* Pedidos: solo con sesión del personal (mesero, cocina, historial) */
    match /pedidos/{pedidoId} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && request.resource.data.keys().hasAll(['tipo','mesa','estado','items','total','creadoEn','actualizadoEn'])
        && request.resource.data.tipo in ['local', 'llevar', 'domicilio']
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.items is list
        && request.resource.data.total is number;
      allow update: if esAdmin()
        && request.resource.data.estado in ['pendiente', 'preparando', 'listo', 'entregado', 'cancelado']
        && request.resource.data.items is list
        && request.resource.data.total is number;
      allow delete: if false;
    }

    /* Reseñas: cualquiera envía (llega pendiente), el público solo ve las aprobadas */
    match /resenas/{id} {
      allow read: if resource.data.estado == 'aprobada' || esAdmin();
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'estrellas', 'comentario', 'estado', 'aceptoPublicar', 'creado'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.aceptoPublicar == true
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 40
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() >= 10 && request.resource.data.comentario.size() <= 500
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.creado == request.time;
      allow update, delete: if esAdmin();
    }

    /* Club: la web ya no inscribe a nadie. Solo el admin ve o borra lo que quedó. */
    match /club/{tel} {
      allow read, update, delete: if esAdmin();
      allow create: if false;
    }

    /* Tarjeta Hornilla (sellos). El id es el código HZ-XXXXXX (sin I, L, O, 0 ni 1).
       • tarjetas: se puede LEER una sola tarjeta si conoces su código (no se puede
         listar ni buscar); solo guarda primer nombre + sellos. Escribe solo el admin.
       • movimientos (historial) y tarjetasClientes (nombre completo + WhatsApp): solo admin. */
    match /tarjetas/{codigo} {
      allow get: if codigo.matches('HZ-[A-HJ-KM-NP-Z2-9]{6}') || esAdmin();
      allow list, write: if esAdmin();

      match /movimientos/{id} {
        allow read, write: if esAdmin();
      }
    }
    match /tarjetasClientes/{tel} {
      allow read, write: if esAdmin();
    }

    /* Configuración pública (interruptor de pupusas y reglas de la tarjeta): todos leen, solo el admin edita */
    match /config/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    /* Canal de WhatsApp: plantillas e historial, solo el admin */
    match /canalPlantillas/{id} {
      allow read, write: if esAdmin();
    }
    match /canalPublicaciones/{id} {
      allow read, write: if esAdmin();
    }
  }
}